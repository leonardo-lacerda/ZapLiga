NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zapcall:zapcall@localhost:5432/zapcall
REDIS_URL=redis://localhost:6379
WAXUM_URL=http://localhost:3451
WAXUM_API_KEY=zapcall-local-waxum-token
WAXUM_JWT_SECRET=change-this-local-secret
WAXUM_GATEWAY_RATE_LIMIT_PER_SECOND=1000000
WAXUM_GATEWAY_RATE_LIMIT_BURST=1000000
WAXUM_REQUEST_INTERVAL_MS=250
API_INSTANCE_ID=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
DASHBOARD_CACHE_TTL_MS=1500
AUTH_REFRESH_ROTATION_GRACE_SECONDS=60
WEB_ORIGIN=http://localhost:5173
MEDIA_RING_TIMEOUT_SECONDS=30
JWT_ACCESS_SECRET=change-this-access-secret
LEGACY_TENANT_ID=tenant-legado
LEGACY_TENANT_NAME=Operação legada
LEGACY_TENANT_SLUG=operacao-legada
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=172800
# Convites de SDR usam link manual e nao dependem de e-mail.
# Resend abaixo continua sendo usado pelos convites genericos de lider.
RESEND_API_KEY=
RESEND_FROM=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
BCRYPT_ROUNDS=12
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_NAME=Admin
