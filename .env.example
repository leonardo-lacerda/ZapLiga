NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zapcall:zapcall@localhost:5432/zapcall
REDIS_URL=redis://localhost:6379
WAXUM_URL=http://localhost:3451
WAXUM_API_KEY=zapcall-local-waxum-token
WAXUM_JWT_SECRET=change-this-local-secret
WAXUM_GATEWAY_RATE_LIMIT_PER_SECOND=1000000
WAXUM_GATEWAY_RATE_LIMIT_BURST=1000000
WAXUM_REQUEST_INTERVAL_MS=250
# Camouflage per line (docs/stealth-profile.md): true makes every line behave as if its switch were
# off, without touching the database. The Waxum side has WA_SESSION_IDENTITY=off.
STEALTH_KILLSWITCH=false
API_INSTANCE_ID=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
DASHBOARD_CACHE_TTL_MS=1500
AUTH_REFRESH_ROTATION_GRACE_SECONDS=60
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
# Billing: start with shadow/off during rollout; use enforce after backfill.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_LIVEMODE=false
STRIPE_PORTAL_CONFIGURATION_ID=
# Leave blank for the safe environment default (off in development/test,
# enforce in any other environment). Use shadow for a staged rollout.
BILLING_ENFORCEMENT_MODE=
BILLING_WORKER_ENABLED=true
BILLING_WORKER_INTERVAL_MS=15000
BILLING_RECONCILE_INTERVAL_MS=300000
BILLING_STALE_AFTER_MS=1800000
MEDIA_RING_TIMEOUT_SECONDS=30
JWT_ACCESS_SECRET=change-this-access-secret
LEGACY_TENANT_ID=tenant-legado
LEGACY_TENANT_NAME=Operação legada
LEGACY_TENANT_SLUG=operacao-legada
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=172800
# Convites de SDR e líder tentam entrega por e-mail e sempre mantêm link copiável.
RESEND_API_KEY=
RESEND_FROM=
DATA_PROTECTION_SECRET=change-this-data-protection-secret
METRICS_TOKEN=change-this-metrics-token
PUBLIC_REGISTRATION_ENABLED=false
VITE_PUBLIC_REGISTRATION_ENABLED=false
E2E_TEST_MODE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
BCRYPT_ROUNDS=12
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_NAME=Admin
# Call recording (tenant flag `call_recording`): stereo Ogg/Opus files kept on
# this disk, transcribed with Whisper on Groq (free plan: 8h of audio per day).
CALL_RECORDING_DIR=/var/lib/zapliga/recordings
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TRANSCRIPTION_PROMPT=
CALL_TRANSCRIPTION_MIN_SECONDS=15
# Internet exit through an attendant's PC (docs/saida-pelo-pc-do-atendente.md):
# set up in Admin → Saídas de internet, nothing here. Only to change the slots:
# WAXUM_EDGE_NODES=edge-1=http://tailscale-edge-1:3451,...
# Cadastro de WhatsApp em cloud phones do GeeLark (recurso interno; flag
# whatsapp_provisioning). Ver docs/provisioning-contract.md.
# Token da API GeeLark (app GeeLark > GeeHub > API): fica só no geelark-worker.
GEELARK_API_TOKEN=
# Segredo compartilhado API <-> worker (header x-worker-token).
GEELARK_WORKER_TOKEN=change-this-worker-token
GEELARK_WORKER_URL=http://localhost:8080
GEELARK_WORKER_MAX_JOBS=2
# Saída do cadastro: o cloud phone sai pelo PC do atendente escolhido (mesmas
# vagas edge-N da saída acima) através do socks-gateway da VPS. O usuário do
# proxy é a vaga (edge-1...) e a senha é EGRESS_SOCKS_PASSWORD.
# Host público da VPS que o GeeLark usa para alcançar o gateway (IP ou nome).
EGRESS_SOCKS_PUBLIC_HOST=
# Porta pública do socks-gateway.
EGRESS_SOCKS_PORT=1080
# Interface onde a porta é publicada: 127.0.0.1 mantém a porta fechada para a
# internet; a produção define 0.0.0.0 para o GeeLark conseguir alcançá-la.
EGRESS_SOCKS_BIND=127.0.0.1
# Senha do gateway (use um segredo forte e longo). Vazia = o gateway recusa tudo.
EGRESS_SOCKS_PASSWORD=
# Como o geelark-worker alcança o mesmo gateway por dentro (descobre o IP do PC).
EGRESS_SOCKS_INTERNAL_URL=socks-gateway:1080
