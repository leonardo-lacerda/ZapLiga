+/// ZapLiga: the handshake of a line that logs in as an Android phone (docs/device-profile.md),
+/// WhatsApp Business (SMB_ANDROID) when the account is Business: no web info, the phone's brand, model and carrier, and a `phone_id` fixed for the line. The
+/// locale is the line's, else `WA_CLIENT_LOCALE`, else the library's.
+fn android_profile(
+    android: &crate::models::sessions::AndroidProfileRequest,
+    locale: Option<&str>,
+) -> wacore::client_profile::ClientProfile {
+    let mut profile = if android.business {
+        wacore::client_profile::ClientProfile::smb_android(android.os_version.trim())
+    } else {
+        wacore::client_profile::ClientProfile::android(android.os_version.trim())
+    };
+    profile.manufacturer = android.manufacturer.trim().to_string();
+    profile.device = android.device.trim().to_string();
+    profile.mcc = android.mcc.trim().to_string();
+    profile.mnc = android.mnc.trim().to_string();
+    profile.phone_id = Some(android.phone_id.trim().to_string());
+    let env_locale = std::env::var("WA_CLIENT_LOCALE").ok();
+    if let Some(locale) = locale.or(env_locale.as_deref()).and_then(non_empty) {
+        apply_locale(&mut profile, locale);
+    }
+    profile
+}
