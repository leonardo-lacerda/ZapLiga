+/// ZapLiga: whether the frozen per-line profile (docs/device-profile.md) is used. Off by
+/// default: with it off the handshake is exactly what the environment produces, which is the
+/// behaviour before the profile existed.
+pub fn frozen_profile_enabled() -> bool {
+    matches!(
+        std::env::var("ZAPLIGA_DEVICE_PROFILE").ok().as_deref(),
+        Some("1") | Some("true") | Some("TRUE") | Some("yes")
+    )
+}
