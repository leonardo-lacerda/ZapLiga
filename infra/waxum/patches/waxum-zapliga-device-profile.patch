+/// ZapLiga: the Android phone a line presents in the handshake, copied from the cloud phone the
+/// number was registered on and frozen per line by the API (docs/device-profile.md).
+#[derive(Debug, Clone, PartialEq, Deserialize, Serialize, ToSchema)]
+pub struct AndroidProfileRequest {
+    /// Android release, e.g. "14".
+    #[schema(example = "14")]
+    pub os_version: String,
+    /// Phone brand, e.g. "samsung".
+    #[schema(example = "samsung")]
+    pub manufacturer: String,
+    /// Phone model, e.g. "SM-A546E".
+    #[schema(example = "SM-A546E")]
+    pub device: String,
+    /// Mobile country code of the carrier, e.g. "724".
+    #[schema(example = "724")]
+    pub mcc: String,
+    /// Mobile network code of the carrier, e.g. "05".
+    #[schema(example = "05")]
+    pub mnc: String,
+    /// Stable per line (never per login): a per-login id made the server drop sessions.
+    pub phone_id: String,
+    /// The account is WhatsApp Business: a Business account only links a second phone that is
+    /// Business too ("Download WhatsApp Business on your other device"), so the login says SMB_ANDROID.
+    #[serde(default)]
+    pub business: bool,
 }
 
