+/// ZapLiga: the attributes an account lock's `<failure>` stanza states about its cause (code,
+/// location, `violation_*`, `vt`, the server's own copy), so the operators can see why a line was
+/// locked. Never the one-time `appeal_token` / `idv_token`: those are credentials, not a cause.
+const ZAPLIGA_LOCK_ATTRS: [&str; 10] = [
+    "reason",
+    "location",
+    "code",
+    "violation_reason",
+    "violation_type",
+    "violated_policy",
+    "vt",
+    "logout_message_header",
+    "logout_message_subtext",
+    "logout_message_locale",
+];
+
+fn zapliga_lock_details(logged_out: &wacore::types::events::LoggedOut) -> serde_json::Value {
+    let mut details = serde_json::Map::new();
+    if let Some(raw) = logged_out.raw.as_ref() {
+        for key in ZAPLIGA_LOCK_ATTRS {
+            if let Some(value) = raw.attrs.get(key) {
+                details.insert(
+                    key.to_string(),
+                    serde_json::Value::String(value.as_str().into_owned()),
+                );
+            }
+        }
+    }
+    serde_json::Value::Object(details)
+}
