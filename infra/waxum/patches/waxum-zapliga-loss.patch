+    #[test]
+    fn zapliga_temp_ban_is_published_with_code_and_expire() {
+        use wacore::types::events::{Event, TempBanReason, TemporaryBan};
+
+        let ban = Event::TemporaryBan(
+            TemporaryBan::builder()
+                .code(TempBanReason::SentToTooManyPeople)
+                .expire(chrono::Duration::seconds(3600))
+                .build(),
+        );
+        assert_eq!(get_event_type(&ban), "temp_banned");
+        let json = event_to_json(&ban, "s1");
+        assert_eq!(json["data"]["code"], 101);
+        assert_eq!(json["data"]["expire_secs"], 3600);
+    }
+
+    #[test]
+    fn zapliga_connect_failure_is_published_with_its_code() {
+        use wacore::types::events::{ConnectFailure, ConnectFailureReason, Event};
+
+        let failure = Event::ConnectFailure(
+            ConnectFailure::builder()
+                .reason(ConnectFailureReason::ClientOutdated)
+                .build(),
+        );
+        assert_eq!(get_event_type(&failure), "connect_failure");
+        assert_eq!(event_to_json(&failure, "s1")["data"]["code"], 405);
+    }
+
+    #[test]
+    fn zapliga_lock_details_keep_the_cause_and_drop_the_appeal_token() {
+        use wacore::types::events::{ConnectFailureReason, LoggedOut};
+        use wacore_binary::builder::NodeBuilder;
+
+        let failure = NodeBuilder::new("failure")
+            .attr("reason", "403")
+            .attr("location", "rva")
+            .attr("violation_reason", "other_harm")
+            .attr("vt", "1")
+            .attr("appeal_token", "0aFICTITIOUSappealTOKEN00")
+            .build();
+        let logged_out = LoggedOut::builder()
+            .on_connect(true)
+            .reason(ConnectFailureReason::AccountLocked)
+            .raw(failure)
+            .build();
+        let details = zapliga_lock_details(&logged_out);
+        assert_eq!(details["violation_reason"], "other_harm");
+        assert_eq!(details["vt"], "1");
+        assert_eq!(details["reason"], "403");
+        assert!(details.get("appeal_token").is_none());
+    }
