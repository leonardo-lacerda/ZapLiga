+/// ZapLiga: the account's reachout timelock (`is_active`, `enforcement_type`,
+/// `time_enforcement_ends`) as the server states it, through the same GraphQL query WA Web runs,
+/// so the dialer waits exactly until the server's deadline instead of a fixed quarantine.
+#[utoipa::path(
+    get,
+    security(("bearer_auth" = [])),
+    path = "/api/v1/sessions/{session_id}/reachout-timelock",
+    tag = "operations",
+    params(
+        ("session_id" = String, Path, description = "Session ID")
+    ),
+    responses(
+        (status = 200, description = "Reachout timelock state"),
+        (status = 503, description = "Not connected")
+    )
+)]
+pub async fn get_reachout_timelock(
+    State(state): State<AppState>,
+    Path(session_id): Path<String>,
+) -> Result<Json<serde_json::Value>, ApiError> {
+    let client = get_client(&state, &session_id)?;
+    let timelock = client
+        .mex()
+        .fetch_reachout_timelock()
+        .await
+        .map_err(|e| ApiError::Internal(e.to_string()))?;
+    serde_json::to_value(timelock)
+        .map(Json)
+        .map_err(|e| ApiError::Internal(e.to_string()))
+}
