+    /// ZapLiga: packet-loss concealment. libopus extrapolates `samples` of audio from its own state
+    /// (an empty packet is how its API asks for that) and fades towards silence over a long gap.
+    /// `samples` must be a whole number of 2.5ms steps, as libopus requires.
+    pub fn conceal(&mut self, samples: usize) -> Result<&[i16]> {
+        self.pcm_scratch.resize(samples.clamp(1, WA_DECODE_MAX_SAMPLES), 0);
+        let n = self
+            .dec
+            .decode(&[], &mut self.pcm_scratch, false)
+            .map_err(|e| anyhow!("opus conceal: {e}"))?;
+        self.pcm_scratch.truncate(n);
+        Ok(&self.pcm_scratch)
+    }
