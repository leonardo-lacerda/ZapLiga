+#[cfg(test)]
+mod zapliga_conceal_tests {
+    use super::*;
+
+    /// Conceals with a recognisable value so a test can tell concealment from silence.
+    struct ConcealToConstant(i16);
+
+    impl ForeignAudioCodec for ConcealToConstant {
+        fn decode(
+            &mut self,
+            _payload: &[u8],
+            _out: &mut Vec<i16>,
+        ) -> Result<(), crate::voip::audio::ForeignCodecError> {
+            Ok(())
+        }
+
+        fn conceal(&mut self, samples: usize, out: &mut Vec<i16>) {
+            out.extend(core::iter::repeat_n(self.0, samples));
+        }
+
+        fn encode(
+            &mut self,
+            _pcm: &[i16],
+            _out: &mut Vec<u8>,
+        ) -> Result<(), crate::voip::audio::ForeignCodecError> {
+            Err(crate::voip::audio::ForeignCodecError::InvalidPayload)
+        }
+    }
+
+    const P: usize = OPUS_FRAME_SAMPS_60MS;
+
+    fn primed_with(samples: usize) -> (VecDeque<i16>, bool, u32) {
+        (core::iter::repeat_n(1i16, samples).collect(), false, 0)
+    }
+
+    #[test]
+    fn zapliga_underrun_is_concealed_instead_of_silenced() {
+        let (mut jitter, mut priming, mut ticks) = primed_with(100);
+        let mut codec = ConcealToConstant(7);
+        let mut concealed = 0;
+        let frame = drain_playout_concealing(
+            &mut jitter, &mut priming, &mut ticks, P, playout_bounds(P).1,
+            Some(&mut codec), &mut concealed,
+        );
+        assert_eq!(frame.len(), PLAYOUT_DRAIN);
+        assert!(frame[..100].iter().all(|&s| s == 1), "queued audio plays first");
+        assert!(frame[100..].iter().all(|&s| s == 7), "the rest is concealment, not silence");
+        assert!(!priming, "a concealed underrun does not re-prime");
+        assert_eq!(concealed, 1);
+    }
+
+    #[test]
+    fn zapliga_late_packet_resumes_without_a_re_prime() {
+        let (mut jitter, mut priming, mut ticks) = primed_with(0);
+        let mut codec = ConcealToConstant(7);
+        let mut concealed = 0;
+        let cap = playout_bounds(P).1;
+        let hidden = drain_playout_concealing(
+            &mut jitter, &mut priming, &mut ticks, P, cap, Some(&mut codec), &mut concealed,
+        );
+        assert!(hidden.iter().all(|&s| s == 7));
+        // The late packet arrives: it plays on the very next tick.
+        jitter.extend(core::iter::repeat_n(3i16, P));
+        let frame = drain_playout_concealing(
+            &mut jitter, &mut priming, &mut ticks, P, cap, Some(&mut codec), &mut concealed,
+        );
+        assert!(frame.iter().all(|&s| s == 3));
+        assert_eq!(concealed, 0, "a full slice resets the run");
+    }
+
+    #[test]
+    fn zapliga_a_stopped_stream_falls_back_to_the_silent_re_prime() {
+        let (mut jitter, mut priming, mut ticks) = primed_with(0);
+        let mut codec = ConcealToConstant(7);
+        let mut concealed = 0;
+        let cap = playout_bounds(P).1;
+        for _ in 0..MAX_CONCEAL_TICKS {
+            let f = drain_playout_concealing(
+                &mut jitter, &mut priming, &mut ticks, P, cap, Some(&mut codec), &mut concealed,
+            );
+            assert!(f.iter().all(|&s| s == 7));
+        }
+        let f = drain_playout_concealing(
+            &mut jitter, &mut priming, &mut ticks, P, cap, Some(&mut codec), &mut concealed,
+        );
+        assert!(f.iter().all(|&s| s == 0), "past the limit the stream is treated as stopped");
+        assert!(priming);
+        assert_eq!(concealed, 0);
+    }
+
+    #[test]
+    fn zapliga_without_a_concealer_playout_is_unchanged() {
+        let (mut jitter, mut priming, mut ticks) = primed_with(100);
+        let frame = drain_playout(&mut jitter, &mut priming, &mut ticks, P, playout_bounds(P).1);
+        assert!(frame[100..].iter().all(|&s| s == 0));
+        assert!(priming);
+    }
+}
