+/// The format a PCM call offers, from `WA_CALL_AUDIO_CODEC` (read once).
+///
+/// `mlow` (the default) offers MLow, whose pure-Rust decoder runs a single operating point
+/// (16 kHz, low_rate=0, 20-120 ms): when the phone switches to its low-bitrate mode or to 10 ms
+/// frames, those frames are dropped and the caller hears holes in the other side's voice.
+/// `opus` offers standard Opus (capability index 31 off), decoded by the linked libopus at every
+/// bitrate and frame size the phone may pick.
+fn pcm_audio_config() -> AudioConfig {
+    static CONFIG: std::sync::OnceLock<AudioConfig> = std::sync::OnceLock::new();
+    *CONFIG.get_or_init(|| match std::env::var("WA_CALL_AUDIO_CODEC").as_deref() {
+        Err(std::env::VarError::NotPresent) | Ok("mlow") => AudioConfig::MLOW_PCM,
+        Ok("opus") => AudioConfig::OPUS_PCM,
+        other => panic!("WA_CALL_AUDIO_CODEC must be `mlow` or `opus`, got {other:?}"),
+    })
+}
+
 impl AudioEndpoints {
     fn config(&self) -> AudioConfig {
         match self {
-            Self::Pcm { .. } => AudioConfig::MLOW_PCM,
+            Self::Pcm { .. } => pcm_audio_config(),
             Self::Encoded { format, .. } => AudioConfig::encoded(*format),
         }
     }
