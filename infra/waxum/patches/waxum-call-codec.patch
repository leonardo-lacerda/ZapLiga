diff -ruN a/Dockerfile b/Dockerfile
--- a/Dockerfile	2026-11-18 16:05:59.332687360 +0100
+++ b/Dockerfile	2026-11-18 16:05:59.335687384 +0100
@@ -15,8 +15,11 @@
 ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
 ENV CARGO_PROFILE_RELEASE_LTO=false
 ENV CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
+ARG CARGO_BUILD_JOBS=6
+ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
 
-RUN rustup default nightly
+# Pinned: a moving nightly can stop compiling this tree; 2026-09-09 built v3.
+RUN rustup default nightly-2026-09-09
 
 COPY Cargo.toml Cargo.lock* ./
 COPY vendor/ ./vendor/
diff -ruN a/docker-entrypoint.sh b/docker-entrypoint.sh
--- a/docker-entrypoint.sh	2026-11-18 16:05:59.332687360 +0100
+++ b/docker-entrypoint.sh	2026-11-18 16:05:59.335687384 +0100
@@ -9,6 +9,13 @@
 # without an operator having to manually fix permissions on the host.
 # Cheap on repeat runs -- chown is a no-op once ownership already matches.
 
+# Read by whatsapp-rust on the first call; a bad value must stop the container
+# here, not fail a call later.
+case "${WA_CALL_AUDIO_CODEC:-mlow}" in
+    mlow|opus) ;;
+    *) echo "WA_CALL_AUDIO_CODEC must be mlow or opus" >&2; exit 1 ;;
+esac
+
 storage_dir="${WHATSAPP_STORAGE_PATH:-/app/whatsapp_sessions}"
 mkdir -p "$storage_dir"
 chown -R waxum:waxum "$storage_dir"
