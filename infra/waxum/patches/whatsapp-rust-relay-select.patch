 const EXTRA_RELAY_KEEPALIVE: std::time::Duration = std::time::Duration::from_secs(1);
 
+/// After the first inbound media packet, outbound media keeps going to every relay this long, so the
+/// answering device has settled on the relay it elected before we stop covering the others.
+const ACTIVE_RELAY_SETTLE_MS: u64 = 3_000;
+/// The relay that carries the peer's media stops being trusted once it has delivered nothing for
+/// this long: outbound media goes to every relay again until one delivers.
+const ACTIVE_RELAY_STALE_MS: u64 = 1_500;
+/// Route index of the primary relay in [`RelayActivity`]; extra relay `i` is route `i + 1`.
+const PRIMARY_ROUTE: usize = 0;
+const BROADCAST_ROUTE: usize = usize::MAX;
+
+/// Which relay the peer's media arrives on, and when.
+///
+/// # Why
+///
+/// Broadcasting every outbound RTP/RTCP packet to every bound relay (see
+/// [`MultiRelayMediaChannelFactory`]) fixed one-way audio but multiplies the outbound bandwidth by
+/// the number of relays -- on a metered residential proxy that is most of a call's cost. The
+/// answering device sends and listens on the one relay it elected, so once its media is seen
+/// arriving on a relay, our media only needs to go there. Until then, during a short settle window,
+/// and whenever that relay goes quiet, outbound falls back to the full broadcast -- the exact
+/// behaviour that fixed one-way audio -- so the saving never costs the call its audio path.
+struct RelayActivity {
+    started: Instant,
+    /// Milliseconds since `started` (+1, so 0 means never) of the first inbound media packet.
+    first_media_ms: AtomicU64,
+    /// Per route, milliseconds since `started` (+1; 0 = never) of the latest inbound media packet.
+    last_media_ms: Vec<AtomicU64>,
+    /// Route outbound media went to last time, only to log changes.
+    chosen: AtomicUsize,
+}
+
+impl RelayActivity {
+    fn new(routes: usize) -> Self {
+        Self {
+            started: Instant::now(),
+            first_media_ms: AtomicU64::new(0),
+            last_media_ms: (0..routes).map(|_| AtomicU64::new(0)).collect(),
+            chosen: AtomicUsize::new(BROADCAST_ROUTE),
+        }
+    }
+
+    fn now_ms(&self) -> u64 {
+        self.started.elapsed().as_millis() as u64 + 1
+    }
+
+    fn media_from(&self, route: usize) {
+        self.media_from_at(route, self.now_ms());
+    }
+
+    fn media_from_at(&self, route: usize, now_ms: u64) {
+        self.last_media_ms[route].store(now_ms, Ordering::Relaxed);
+        let _ = self
+            .first_media_ms
+            .compare_exchange(0, now_ms, Ordering::Relaxed, Ordering::Relaxed);
+    }
+
+    /// The one route outbound media should take at `now_ms`, or `None` to broadcast.
+    fn active_at(&self, now_ms: u64) -> Option<usize> {
+        let first = self.first_media_ms.load(Ordering::Relaxed);
+        if first == 0 || now_ms < first + ACTIVE_RELAY_SETTLE_MS {
+            return None;
+        }
+        let (route, last) = self
+            .last_media_ms
+            .iter()
+            .map(|at| at.load(Ordering::Relaxed))
+            .enumerate()
+            .max_by_key(|&(_, at)| at)?;
+        (last != 0 && now_ms.saturating_sub(last) <= ACTIVE_RELAY_STALE_MS).then_some(route)
+    }
+
+    fn note_choice(&self, route: Option<usize>) {
+        let route = route.unwrap_or(BROADCAST_ROUTE);
+        if self.chosen.swap(route, Ordering::Relaxed) != route {
+            match route {
+                BROADCAST_ROUTE => log::info!("voip: outbound media back to every relay"),
+                PRIMARY_ROUTE => log::info!("voip: outbound media only to the primary relay"),
+                extra => log::info!("voip: outbound media only to extra relay #{extra}"),
+            }
+        }
+    }
+}
