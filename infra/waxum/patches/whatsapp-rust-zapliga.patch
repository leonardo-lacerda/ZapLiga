+/// How often an extra relay's allocate is re-sent to keep its consent fresh. The engine drives the
+/// primary relay's own consent on its usual schedule; this is this module's equivalent for the
+/// endpoints the engine never learns about.
+const EXTRA_RELAY_KEEPALIVE: std::time::Duration = std::time::Duration::from_secs(1);
+
+/// A [`RelayTransportFactory`] that binds the primary relay endpoint the engine selected plus every
+/// other usable relay the offer carried, and presents the lot to the engine as one
+/// [`RelayTransport`].
+///
+/// # Why binding one relay is not enough
+///
+/// The engine picks one endpoint (`get_media_relay_endpoint`) and [`dial_candidates`] only races
+/// that HOST's advertised port against the web-client one -- both are about which port of the SAME
+/// host to use. Neither says anything about the device that answers: it runs its own relay
+/// election after accepting and may migrate its media to a DIFFERENT host in the offer than the one
+/// we picked. When it does, our single-relay socket never sees that media again -- the STUN
+/// allocate still succeeds and consent pings still answer, so nothing looks wrong, but inbound RTP
+/// simply never arrives. This is the live, packet-captured signature of ZapCall's one-way-audio
+/// incidents (see `docs/audio-call-fix.md`) and matches the independently-diagnosed and
+/// production-validated root cause of the same symptom in a sibling WhatsApp-calling
+/// implementation: <https://github.com/purpshell/meowcaller/pull/26>.
+///
+/// The official client never bets on one relay for exactly this reason (`ConfigureRelays`/
+/// `Broadcast` in the WaCalls reference): it allocates on every offered relay and merges whatever
+/// each one delivers. This factory is the same fix, scoped to this codebase's transport seam.
+///
+/// # What stays single-relay
+///
+/// The engine's own STUN allocate/consent state machine is untouched and still drives the primary
+/// relay exactly as before [`RelayMediaChannelFactory`] alone did -- this factory only ADDS
+/// independent, best-effort allocate/consent loops for the other endpoints, run entirely in this
+/// module ([`drive_extra_relay`]). Their allocate responses are never forwarded to the engine (it
+/// did not send them and would not recognise the transaction id); only RTP/RTCP arriving on them
+/// is. A frame that reaches the engine by more than one relay is rejected by the SRTP replay window
+/// exactly like a retransmission would be, so no deduplication happens here.
+pub struct MultiRelayMediaChannelFactory {
+    primary_addr: SocketAddr,
+    extras: Vec<ExtraRelayEndpoint>,
+    alloc_ctx: RelayAllocateContext,
+    runtime: Arc<dyn Runtime>,
+}
+
+impl MultiRelayMediaChannelFactory {
+    pub fn new(
+        primary_addr: SocketAddr,
+        extras: Vec<ExtraRelayEndpoint>,
+        alloc_ctx: RelayAllocateContext,
+        runtime: Arc<dyn Runtime>,
+    ) -> Self {
+        Self {
+            primary_addr,
+            extras,
+            alloc_ctx,
+            runtime,
+        }
+    }
+}
+
+#[async_trait]
+impl RelayTransportFactory for MultiRelayMediaChannelFactory {
+    async fn connect(
+        &self,
+    ) -> Result<(
+        Arc<dyn RelayTransport>,
+        async_channel::Receiver<RelayTransportEvent>,
+    )> {
+        // The primary is the one connect() must succeed or fail on -- same contract
+        // RelayMediaChannelFactory alone had, so a caller waiting on this still gets the same
+        // timeout/error behaviour when the offer names only one usable relay (extras: []).
+        let (primary, primary_events) =
+            RelayMediaChannelFactory::new(self.primary_addr, self.runtime.clone())
+                .connect()
+                .await?;
+
+        let (merged_tx, merged_rx) = async_channel::bounded(RELAY_EVENT_CAP);
+        let mut tasks = Vec::with_capacity(1 + self.extras.len());
+
+        // Pass the primary's own events straight through -- it stays the stream the call's
+        // Connected/Disconnected state and its media come from.
+        {
+            let merged_tx = merged_tx.clone();
+            tasks.push(self.runtime.spawn(Box::pin(async move {
+                while let Ok(event) = primary_events.recv().await {
+                    if merged_tx.send(event).await.is_err() {
+                        return;
+                    }
+                }
+            })));
+        }
+
+        let mut extra_outbound = Vec::with_capacity(self.extras.len());
+        for extra in &self.extras {
+            let (outbound_tx, outbound_rx) = async_channel::bounded(RELAY_SEND_CAP);
+            extra_outbound.push(outbound_tx);
+            tasks.push(self.runtime.spawn(Box::pin(drive_extra_relay(
+                extra.clone(),
+                self.alloc_ctx.clone(),
+                self.runtime.clone(),
+                outbound_rx,
+                merged_tx.clone(),
+            ))));
+        }
+
+        Ok((
+            Arc::new(MultiRelayTransport {
+                primary,
+                extra_outbound,
+                _tasks: tasks,
+            }),
+            merged_rx,
+        ))
+    }
+}
+
+/// Connect one extra relay, allocate on it with its own token, keep that allocate's consent fresh,
+/// forward whatever it sends us, and drain `outbound` onto it. Ends quietly -- never propagating a
+/// failure to the call -- on connect failure, a closed `outbound` (the transport disconnecting), or
+/// a lost channel: an extra relay is a bonus path, and losing one must cost the call nothing more
+/// than the media it would have carried.
+async fn drive_extra_relay(
+    extra: ExtraRelayEndpoint,
+    ctx: RelayAllocateContext,
+    runtime: Arc<dyn Runtime>,
+    outbound: async_channel::Receiver<Bytes>,
+    merged_tx: async_channel::Sender<RelayTransportEvent>,
+) {
+    let Ok((channel, events)) = connect_relay_media(extra.addr, runtime).await else {
+        return;
+    };
+    let Some(endpoint_xor) =
+        wacore::voip::stun::encode_xor_relay_endpoint(&extra.addr.ip().to_string(), extra.addr.port())
+    else {
+        return;
+    };
+    let allocate = Bytes::from(wacore::voip::stun::build_wasm_stun_allocate_request(
+        &rand::random(),
+        &extra.relay_token,
+        &endpoint_xor,
+        &ctx.integrity_key,
+        &ctx.call_id,
+        &ctx.self_participant_id,
+    ));
+    if channel.send(allocate.clone()).await.is_err() {
+        return;
+    }
+    let mut keepalive = tokio::time::interval(EXTRA_RELAY_KEEPALIVE);
+    keepalive.tick().await; // first tick fires immediately; the allocate above already went out
+    loop {
+        tokio::select! {
+            _ = keepalive.tick() => {
+                if channel.send(allocate.clone()).await.is_err() {
+                    return;
+                }
+            }
+            queued = outbound.recv() => {
+                match queued {
+                    Ok(data) => {
+                        if channel.send(data).await.is_err() {
+                            return;
+                        }
+                    }
+                    // MultiRelayTransport::disconnect closed our outbound queue: say goodbye on
+                    // this relay too, rather than just abandoning the socket.
+                    Err(_) => {
+                        channel.disconnect().await;
+                        return;
+                    }
+                }
+            }
+            event = events.recv() => {
+                match event {
+                    Ok(RelayTransportEvent::PacketReceived(bytes)) => {
+                        if matches!(
+                            classify_relay_packet(&bytes),
+                            RelayPacketKind::Rtp | RelayPacketKind::Rtcp
+                        ) && merged_tx
+                            .send(RelayTransportEvent::PacketReceived(bytes))
+                            .await
+                            .is_err()
+                        {
+                            return;
+                        }
+                        // A Stun/Other packet here is this relay's own allocate-success or consent
+                        // reply -- our bookkeeping, not the call's; the engine never sent the
+                        // request and would not recognise the transaction id.
+                    }
+                    Ok(RelayTransportEvent::Disconnected(_)) | Err(_) => return,
+                    Ok(_) => {}
+                }
+            }
+        }
+    }
+}
+
+/// Broadcasts RTP/RTCP to the primary relay and every bound extra; everything else -- the engine's
+/// own STUN allocate/consent for the primary -- goes only to the primary, the one relay that state
+/// machine actually tracks.
+struct MultiRelayTransport {
+    primary: Arc<dyn RelayTransport>,
+    extra_outbound: Vec<async_channel::Sender<Bytes>>,
+    /// Keeps the primary-event-forwarder and extra-relay driver tasks alive: each aborts on its own
+    /// `Drop` (see `Runtime::spawn`'s contract) once this transport itself is dropped, mirroring how
+    /// `RelayMediaChannel` holds its own driver's handle.
+    _tasks: Vec<AbortHandle>,
+}
+
+#[async_trait]
+impl RelayTransport for MultiRelayTransport {
+    async fn send(&self, data: Bytes) -> Result<()> {
+        if matches!(
+            classify_relay_packet(&data),
+            RelayPacketKind::Rtp | RelayPacketKind::Rtcp
+        ) {
+            for tx in &self.extra_outbound {
+                // Best-effort and non-blocking: one slow or gone extra relay must never hold up the
+                // call's own send, which still has to reach the primary below.
+                let _ = tx.try_send(data.clone());
+            }
+        }
+        self.primary.send(data).await
+    }
+
+    async fn disconnect(&self) {
+        for tx in &self.extra_outbound {
+            tx.close();
+        }
+        self.primary.disconnect().await;
+    }
+}
