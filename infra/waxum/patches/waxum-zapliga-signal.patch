+/// ZapLiga: the noise-handshake profile from `WA_CLIENT_OS_VERSION` and `WA_CLIENT_LOCALE`
+/// (e.g. `pt_BR`), so the login matches the registered device and the operation's country.
+/// `None` when neither is set, which keeps the library's web profile.
+pub fn client_profile_from_env() -> Option<wacore::client_profile::ClientProfile> {
+    let os_version = std::env::var("WA_CLIENT_OS_VERSION")
+        .ok()
+        .filter(|value| !value.trim().is_empty());
+    let locale = std::env::var("WA_CLIENT_LOCALE")
+        .ok()
+        .filter(|value| !value.trim().is_empty());
+    if os_version.is_none() && locale.is_none() {
+        return None;
+    }
+    let mut profile = wacore::client_profile::ClientProfile::web();
+    if let Some(os_version) = os_version {
+        profile.os_version = os_version.trim().to_string();
+    }
+    if let Some(locale) = locale {
+        let mut parts = locale.trim().split(|c| c == '_' || c == '-');
+        if let Some(language) = parts.next().filter(|part| !part.is_empty()) {
+            profile.locale_language = language.to_ascii_lowercase();
+        }
+        if let Some(country) = parts.next().filter(|part| !part.is_empty()) {
+            profile.locale_country = country.to_ascii_uppercase();
+        }
+    }
+    Some(profile)
+}
