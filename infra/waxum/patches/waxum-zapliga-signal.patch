+/// ZapLiga: one live client per session across every Waxum on the shared volume. Two clients
+/// with the same device keys make WhatsApp drop the device, and the pidfile cannot tell the
+/// containers apart (every one runs as PID 1). The lock is an exclusive `flock` on
+/// `{session}/.session.lock`, held by the returned file while the client runs and released by the
+/// kernel if the process dies. Re-entrant inside one Waxum (a reconnect may overlap the client it
+/// replaces); another Waxum waits a little (a move releases the source first) and then gives up.
+async fn lock_session_storage(
+    storage_path: &str,
+    session_id: &str,
+) -> Result<std::sync::Arc<std::fs::File>, ApiError> {
+    static HELD: std::sync::OnceLock<
+        parking_lot::Mutex<std::collections::HashMap<String, std::sync::Weak<std::fs::File>>>,
+    > = std::sync::OnceLock::new();
+    let held = HELD.get_or_init(|| parking_lot::Mutex::new(std::collections::HashMap::new()));
+    if let Some(file) = held.lock().get(session_id).and_then(|weak| weak.upgrade()) {
+        return Ok(file);
+    }
+    let _ = std::fs::create_dir_all(storage_path);
+    let path = format!("{}/.session.lock", storage_path);
+    let file = std::fs::OpenOptions::new()
+        .create(true)
+        .write(true)
+        .truncate(false)
+        .open(&path)
+        .map_err(|e| ApiError::Internal(format!("session lock {}: {}", path, e)))?;
+    for _ in 0..40 {
+        if file.try_lock().is_ok() {
+            let file = std::sync::Arc::new(file);
+            held.lock()
+                .insert(session_id.to_string(), std::sync::Arc::downgrade(&file));
+            return Ok(file);
+        }
+        tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+    }
+    tracing::warn!(
+        session_id = %session_id,
+        "session is open in another Waxum; not starting a second client"
+    );
+    Err(ApiError::Internal(format!(
+        "session {} is already open in another Waxum",
+        session_id
+    )))
+}
