+/// `pt_BR` / `pt-BR` into the profile's ISO-639-1 language and ISO-3166 country.
+fn apply_locale(profile: &mut wacore::client_profile::ClientProfile, locale: &str) {
+    let mut parts = locale.trim().split(|c| c == '_' || c == '-');
+    if let Some(language) = parts.next().filter(|part| !part.is_empty()) {
+        profile.locale_language = language.to_ascii_lowercase();
+    }
+    if let Some(country) = parts.next().filter(|part| !part.is_empty()) {
+        profile.locale_country = country.to_ascii_uppercase();
+    }
+}
