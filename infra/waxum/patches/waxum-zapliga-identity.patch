+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::models::sessions::{ClientProfileRequest, DevicePropsRequest};
+
+    fn stealth_request() -> IdentityRequest {
+        IdentityRequest {
+            device: Some(DevicePropsRequest {
+                os: Some("Windows".into()),
+                platform: Some("edge".into()),
+                version: None,
+            }),
+            client_profile: Some(ClientProfileRequest {
+                locale: Some("pt_BR".into()),
+                reset: false,
+            }),
+        }
+    }
+
+    fn platform_name(identity: &ResolvedIdentity) -> String {
+        format!("{:?}", identity.device.platform)
+    }
+
+    #[test]
+    fn zapliga_identity_session_without_one_builds_as_before() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+
+        let identity = resolve_session_identity_with(path, &IdentityRequest::default(), true);
+
+        let env = resolve_from_env();
+        assert_eq!(identity.device.os, env.os);
+        assert_eq!(platform_name(&identity), format!("{:?}", env.platform));
+        assert_eq!(identity.client_profile.is_some(), client_profile_from_env().is_some());
+        assert!(!dir.path().join(IDENTITY_FILE).exists());
+    }
+
+    #[test]
+    fn zapliga_identity_is_saved_and_reused_by_later_logins() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+
+        resolve_session_identity_with(path, &stealth_request(), true);
+        let later = resolve_session_identity_with(path, &IdentityRequest::default(), true);
+
+        assert_eq!(later.device.os, "Windows");
+        assert_eq!(platform_name(&later), format!("{:?}", parse_platform("edge")));
+        let profile = later.client_profile.expect("saved locale");
+        assert_eq!(profile.locale_language, "pt");
+        assert_eq!(profile.locale_country, "BR");
+    }
+
+    #[test]
+    fn zapliga_identity_changes_only_the_locale_of_the_web_profile() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+
+        let profile = resolve_session_identity_with(path, &stealth_request(), true)
+            .client_profile
+            .expect("locale");
+
+        let web = wacore::client_profile::ClientProfile::web();
+        assert_eq!(profile.user_agent_platform, web.user_agent_platform);
+        assert_eq!(profile.device, web.device);
+        assert_eq!(profile.os_version, web.os_version);
+        assert_eq!(profile.manufacturer, web.manufacturer);
+        assert_eq!(profile.include_web_info, web.include_web_info);
+        assert!(profile.phone_id.is_none());
+    }
+
+    #[test]
+    fn zapliga_identity_reset_deletes_it() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+        resolve_session_identity_with(path, &stealth_request(), true);
+
+        let reset = IdentityRequest {
+            device: None,
+            client_profile: Some(ClientProfileRequest { locale: None, reset: true }),
+        };
+        let identity = resolve_session_identity_with(path, &reset, true);
+
+        assert!(!dir.path().join(IDENTITY_FILE).exists());
+        assert_eq!(identity.device.os, resolve_from_env().os);
+        assert_eq!(identity.client_profile.is_some(), client_profile_from_env().is_some());
+    }
+
+    #[test]
+    fn zapliga_identity_killswitch_ignores_the_saved_one() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+        resolve_session_identity_with(path, &stealth_request(), true);
+
+        let identity = resolve_session_identity_with(path, &IdentityRequest::default(), false);
+
+        assert_eq!(identity.device.os, resolve_from_env().os);
+        assert_eq!(identity.client_profile.is_some(), client_profile_from_env().is_some());
+    }
+
+    #[test]
+    fn zapliga_identity_killswitch_keeps_the_request_device_as_before() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+
+        let identity = resolve_session_identity_with(path, &stealth_request(), false);
+
+        assert_eq!(platform_name(&identity), format!("{:?}", parse_platform("edge")));
+        assert!(!dir.path().join(IDENTITY_FILE).exists());
+    }
+
+    #[test]
+    fn zapliga_identity_unreadable_file_falls_back_to_the_env() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap();
+        std::fs::write(dir.path().join(IDENTITY_FILE), b"{not json").unwrap();
+
+        let identity = resolve_session_identity_with(path, &IdentityRequest::default(), true);
+
+        assert_eq!(identity.device.os, resolve_from_env().os);
+    }
+}
