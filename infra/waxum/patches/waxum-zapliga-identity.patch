+}
+
+/// File, next to the session's keys, with the identity the line asked for. Every Waxum mounts
+/// the same session volume, so it follows the line when the egress pool moves it.
+const IDENTITY_FILE: &str = "zapliga-identity.json";
+
+#[derive(Debug, Clone, Default, PartialEq, serde::Serialize, serde::Deserialize)]
+struct SavedIdentity {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    device_os: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    device_platform: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    device_version: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    locale: Option<String>,
+}
+
+/// ZapLiga: the identity of a session, per line instead of per container (docs/stealth-profile.md).
+/// Precedence: the request, then the identity saved with the session, then the env
+/// (`WA_DEVICE_*`, `WA_CLIENT_*`), then the library default. A request's identity is saved;
+/// `client_profile.reset` deletes it. A session that never asked for one builds exactly as before.
+/// `WA_SESSION_IDENTITY=off` (killswitch) ignores the saved identity and the request's
+/// `client_profile`, as before this existed; the request's `device` still applies, as it always did.
+pub fn resolve_session_identity(storage_path: &str, request: &IdentityRequest) -> ResolvedIdentity {
+    let enabled = std::env::var("WA_SESSION_IDENTITY")
+        .map(|value| !value.trim().eq_ignore_ascii_case("off"))
+        .unwrap_or(true);
+    resolve_session_identity_with(storage_path, request, enabled)
+}
+
+fn resolve_session_identity_with(
+    storage_path: &str,
+    request: &IdentityRequest,
+    enabled: bool,
+) -> ResolvedIdentity {
+    let saved = if enabled {
+        update_saved_identity(&std::path::Path::new(storage_path).join(IDENTITY_FILE), request)
+    } else {
+        SavedIdentity::default()
+    };
+    let device = request.device.as_ref();
+    let pick = |requested: Option<&str>, saved: &Option<String>| {
+        requested.and_then(non_empty).map(str::to_string).or_else(|| saved.clone())
+    };
+    let os = pick(device.and_then(|d| d.os.as_deref()), &saved.device_os);
+    let platform = pick(device.and_then(|d| d.platform.as_deref()), &saved.device_platform);
+    let version = pick(device.and_then(|d| d.version.as_deref()), &saved.device_version);
+    let client_profile = match saved.locale.as_deref() {
+        Some(locale) => {
+            let mut profile = client_profile_from_env()
+                .unwrap_or_else(wacore::client_profile::ClientProfile::web);
+            apply_locale(&mut profile, locale);
+            Some(profile)
         }
-        if let Some(country) = parts.next().filter(|part| !part.is_empty()) {
-            profile.locale_country = country.to_ascii_uppercase();
+        None => client_profile_from_env(),
+    };
+    ResolvedIdentity {
+        device: resolve_with_override(os.as_deref(), platform.as_deref(), version.as_deref()),
+        client_profile,
+    }
+}
+
+/// Applies the request to the saved identity and writes it back when it changed.
+fn update_saved_identity(path: &std::path::Path, request: &IdentityRequest) -> SavedIdentity {
+    let reset = request.client_profile.as_ref().is_some_and(|c| c.reset);
+    let saved = if reset {
+        if let Err(e) = std::fs::remove_file(path) {
+            if e.kind() != std::io::ErrorKind::NotFound {
+                tracing::warn!("identity {}: not removed: {}", path.display(), e);
+            }
         }
+        SavedIdentity::default()
+    } else {
+        read_saved_identity(path)
+    };
+    let mut next = saved.clone();
+    let set = |field: &mut Option<String>, value: Option<&str>| {
+        if let Some(value) = value.and_then(non_empty) {
+            *field = Some(value.to_string());
+        }
+    };
+    if let Some(device) = &request.device {
+        set(&mut next.device_os, device.os.as_deref());
+        set(&mut next.device_platform, device.platform.as_deref());
+        set(&mut next.device_version, device.version.as_deref());
+    }
+    if let Some(client) = &request.client_profile {
+        set(&mut next.locale, client.locale.as_deref());
+    }
+    if next != saved {
+        write_saved_identity(path, &next);
+    }
+    next
+}
+
+/// A missing or unreadable file is no identity: the line still connects, on the env defaults.
+fn read_saved_identity(path: &std::path::Path) -> SavedIdentity {
+    match std::fs::read(path) {
+        Ok(bytes) => serde_json::from_slice(&bytes).unwrap_or_else(|e| {
+            tracing::warn!("identity {}: unreadable, ignored: {}", path.display(), e);
+            SavedIdentity::default()
+        }),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => SavedIdentity::default(),
+        Err(e) => {
+            tracing::warn!("identity {}: unreadable, ignored: {}", path.display(), e);
+            SavedIdentity::default()
+        }
+    }
+}
+
+/// Written to a temporary file and renamed, so a reader never sees half of it.
+fn write_saved_identity(path: &std::path::Path, identity: &SavedIdentity) {
+    let tmp = path.with_extension("json.tmp");
+    let result = serde_json::to_vec(identity)
+        .map_err(std::io::Error::other)
+        .and_then(|bytes| std::fs::write(&tmp, bytes))
+        .and_then(|_| std::fs::rename(&tmp, path));
+    if let Err(e) = result {
+        tracing::warn!("identity {}: not saved: {}", path.display(), e);
     }
